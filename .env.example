# Copie para .env e preencha. NUNCA commite o .env.

# --- LiteLLM Proxy (único container com acesso à OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Chave que o backend usa para autenticar no LiteLLM Proxy
LITELLM_MASTER_KEY=sk-litellm-change-me

# --- Modelos (slugs OpenRouter; aliases resolvidos no docker/litellm/config.yaml) ---
# Confirmados na implementação da issue #7
EXTRACTION_MODEL=extraction-model
ANALYSIS_MODEL=analysis-model

# --- Backend ---
LITELLM_BASE_URL=http://litellm:4000/v1
DATABASE_URL=sqlite+aiosqlite:////data/app.db
UPLOAD_DIR=/data/uploads

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me
